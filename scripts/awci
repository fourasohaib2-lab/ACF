#!/usr/bin/env bash
# Quick terminal launcher for the standalone AWCI dashboard window
# (acf.gui.dashboard.awci_window.AWCIDashboardWindow), bypassing the full
# ESOC shell. Usage:
#   ./scripts/awci
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
PYTHON="$REPO_ROOT/.venv/bin/python"

if [[ ! -x "$PYTHON" ]]; then
    echo "error: $PYTHON not found (expected the project's .venv with PySide6 installed)" >&2
    exit 1
fi

exec "$PYTHON" -c "
import sys
from PySide6.QtWidgets import QApplication
from acf.gui.dashboard.awci_window import AWCIDashboardWindow

app = QApplication(sys.argv)
win = AWCIDashboardWindow()
win.show()
win.raise_()
win.activateWindow()
sys.exit(app.exec())
"
