"""
AWCI Dashboard
==============

Complete AWCI dashboard with all components:
- AWCI Global Map (carte)
- Statistics (Mean, Max, Area, Confidence)
- Point Information (Lat, Lon, FL, AWCI)
- AWCI Components (decomposition)
- Operational Use (timeline)
- Synthetic View
"""

from PySide6.QtWidgets import (
    QWidget, QVBoxLayout, QHBoxLayout, QLabel, QFrame, QGridLayout, QPushButton
)
from PySide6.QtCore import Qt, QSize
from PySide6.QtGui import QFont

from typing import Optional, Dict, Any

from .awci_gauge import AWCIGauge
from .awci_decomposition import AWCIDecomposition


class AWCIDashboard(QWidget):
    """Complete AWCI Dashboard with all components."""

    def __init__(self, parent: Optional[QWidget] = None):
        super().__init__(parent)

        self.gauge = AWCIGauge()
        self.decomposition = AWCIDecomposition()

        self._stats = {}
        self._point_info = {}
        self._timeline_data = []
        self._vertical_profile = {}

        self._build_ui()
        self._apply_theme()
        self._apply_default_data()

    def _build_ui(self):
        """Build the complete dashboard UI."""
        main_layout = QVBoxLayout()
        main_layout.setSpacing(8)
        main_layout.setContentsMargins(12, 12, 12, 12)

        # ==========================================
        # HEADER
        # ==========================================
        header = QLabel("AWCI – AVIATION WEATHER COMPLEXITY INDEX")
        header.setStyleSheet("color: #e0e0e0; font-size: 14px; font-weight: bold; letter-spacing: 0.5px;")
        main_layout.addWidget(header)

        subheader = QLabel("Concept Output – Research Prototype")
        subheader.setStyleSheet("color: #8080a0; font-size: 10px; margin-bottom: 5px;")
        main_layout.addWidget(subheader)

        # ==========================================
        # SECTION 1: AWCI GLOBAL MAP
        # ==========================================
        map_section = QFrame()
        map_section.setStyleSheet("""
            QFrame {
                background-color: #16213e;
                border: 1px solid #2a2a4a;
                border-radius: 6px;
                padding: 8px;
            }
        """)
        map_layout = QHBoxLayout(map_section)

        # Left: Map placeholder / Gauge
        map_left = QVBoxLayout()
        map_left.addWidget(self.gauge)

        # Right: Statistics
        stats_right = QVBoxLayout()
        stats_right.setSpacing(2)

        self.stat_mean = QLabel("Global Mean AWCI: --  --")
        self.stat_max = QLabel("Max AWCI: --  --")
        self.stat_area = QLabel("Area with AWCI > 60: --")
        self.stat_confidence = QLabel("Forecast Confidence: --")
        self.stat_module = QLabel("Module: --")
        self.stat_run = QLabel("Run: --")

        for label in [self.stat_mean, self.stat_max, self.stat_area,
                      self.stat_confidence, self.stat_module, self.stat_run]:
            label.setStyleSheet("color: #a0a0c0; font-size: 10px; padding: 1px 0;")
            stats_right.addWidget(label)

        map_layout.addLayout(map_left, 50)
        map_layout.addLayout(stats_right, 50)

        main_layout.addWidget(map_section)

        # ==========================================
        # SECTION 2: POINT INFORMATION + VERTICAL PROFILE
        # ==========================================
        info_section = QFrame()
        info_section.setStyleSheet("""
            QFrame {
                background-color: #16213e;
                border: 1px solid #2a2a4a;
                border-radius: 6px;
                padding: 8px;
            }
        """)
        info_layout = QHBoxLayout(info_section)

        # Left: Point Information
        point_info = QVBoxLayout()
        point_info.setSpacing(1)

        title_point = QLabel("POINT INFORMATION")
        title_point.setStyleSheet("color: #e0e0e0; font-size: 10px; font-weight: bold; margin-bottom: 3px;")
        point_info.addWidget(title_point)

        self.point_lat = QLabel("Lat: --")
        self.point_lon = QLabel("Lon: --")
        self.point_fl = QLabel("FL: --")
        self.point_awci = QLabel("AWCI: --  --")
        self.point_profile = QLabel("See Vertical Profile")

        for label in [self.point_lat, self.point_lon, self.point_fl,
                      self.point_awci, self.point_profile]:
            label.setStyleSheet("color: #a0a0c0; font-size: 10px; padding: 1px 0;")
            point_info.addWidget(label)

        # Right: Vertical Profile (simplified)
        profile_widget = QWidget()
        profile_widget.setMinimumHeight(80)
        profile_widget.setStyleSheet("background: transparent;")
        # We'll implement a simple profile display using labels

        profile_layout = QVBoxLayout(profile_widget)
        profile_layout.setSpacing(1)

        title_profile = QLabel("VERTICAL PROFILE AWCI")
        title_profile.setStyleSheet("color: #e0e0e0; font-size: 10px; font-weight: bold;")
        profile_layout.addWidget(title_profile)

        self.profile_labels = {}
        for fl in ['FL350', 'FL300', 'FL250', 'FL200', 'FL150', 'FL100']:
            lbl = QLabel(f"{fl}: --")
            lbl.setStyleSheet("color: #8080a0; font-size: 9px;")
            self.profile_labels[fl] = lbl
            profile_layout.addWidget(lbl)

        profile_layout.addStretch()

        info_layout.addLayout(point_info, 50)
        info_layout.addWidget(profile_widget, 50)

        main_layout.addWidget(info_section)

        # ==========================================
        # SECTION 3: AWCI COMPONENTS (Decomposition)
        # ==========================================
        comp_section = QFrame()
        comp_section.setStyleSheet("""
            QFrame {
                background-color: #16213e;
                border: 1px solid #2a2a4a;
                border-radius: 6px;
                padding: 8px;
            }
        """)
        comp_layout = QHBoxLayout(comp_section)

        # Title + Decomposition
        comp_left = QVBoxLayout()
        title_comp = QLabel("AWCI COMPONENTS (EXAMPLE AT POINT)")
        title_comp.setStyleSheet("color: #e0e0e0; font-size: 10px; font-weight: bold; margin-bottom: 3px;")
        comp_left.addWidget(title_comp)

        # Point info for components
        self.comp_point = QLabel("Lat: --  Lon: --  FL: --  AWCI: --")
        self.comp_point.setStyleSheet("color: #a0a0c0; font-size: 9px; margin-bottom: 3px;")
        comp_left.addWidget(self.comp_point)

        comp_left.addWidget(self.decomposition)

        comp_layout.addLayout(comp_left)

        main_layout.addWidget(comp_section)

        # ==========================================
        # SECTION 4: SYNTHETIC VIEW
        # ==========================================
        synth_section = QFrame()
        synth_section.setStyleSheet("""
            QFrame {
                background-color: #16213e;
                border: 1px solid #2a2a4a;
                border-radius: 6px;
                padding: 8px;
            }
        """)
        synth_layout = QVBoxLayout(synth_section)

        title_synth = QLabel("SYNTHETIC VIEW")
        title_synth.setStyleSheet("color: #e0e0e0; font-size: 10px; font-weight: bold;")
        synth_layout.addWidget(title_synth)

        synth_items = [
            "✓ One map to understand the complexity",
            "✓ DECISION SUPPORT: Helps forecasters and aircrews",
            "✓ MULTI-SCALE: Global - Regional - Vertical - Time evolution",
            "✓ ADAPTIVE TO MISSION: Depends on aircraft, phase of flight and operation",
            "✓ RESEARCH STAGE: Prototype - To be validated and improved",
        ]

        for item in synth_items:
            lbl = QLabel(item)
            lbl.setStyleSheet("color: #8080a0; font-size: 9px; padding: 1px 0;")
            synth_layout.addWidget(lbl)

        main_layout.addWidget(synth_section)

        self.setLayout(main_layout)

    def _apply_theme(self):
        """Apply ACF dark theme."""
        self.setStyleSheet("""
            QWidget {
                background-color: #1a1a2e;
                color: #e0e0e0;
                font-family: 'Segoe UI', 'Ubuntu', sans-serif;
            }
            QFrame {
                background-color: #16213e;
                border: 1px solid #2a2a4a;
                border-radius: 6px;
            }
        """)

    def _apply_default_data(self):
        """Apply default test data."""
        test_data = {
            'awci': 62.5,
            'decomposition': {
                'dynamic': 40.0,
                'thermodynamic': 30.0,
                'convective': 20.0,
                'microphysical': 10.0,
                'topographic': 8.0,
                'temporal': 7.0,
                'confidence': 5.0,
            },
            'mean_awci': 32,
            'max_awci': 92,
            'area_above_60': 18.7,
            'confidence': 75,
            'module': 'AROME + ALADIN',
            'run': '00Z',
            'point_lat': '33.0 N',
            'point_lon': '3.0 E',
            'point_fl': '100 (=3000 m)',
            'point_awci': 67,
            'vertical_profile': {
                'FL350': 75,
                'FL300': 62,
                'FL250': 55,
                'FL200': 42,
                'FL150': 30,
                'FL100': 18,
            }
        }
        self.update_with_awci_result(test_data)

    def update_with_awci_result(self, result: Dict[str, Any]):
        """Update all dashboard components with AWCI result."""
        # Gauge
        self.gauge.set_score(result.get('awci', 0))

        # Decomposition
        self.decomposition.set_decomposition(result.get('decomposition', {}))

        # Statistics
        mean_awci = result.get('mean_awci', '--')
        max_awci = result.get('max_awci', '--')
        area = result.get('area_above_60', '--')
        conf = result.get('confidence', '--')
        module = result.get('module', '--')
        run = result.get('run', '--')

        self.stat_mean.setText(f"Global Mean AWCI: {mean_awci}  Moderate")
        self.stat_max.setText(f"Max AWCI: {max_awci}  Very High")
        self.stat_area.setText(f"Area with AWCI > 60: {area}%")
        self.stat_confidence.setText(f"Forecast Confidence: {conf}%")
        self.stat_module.setText(f"Module: {module}")
        self.stat_run.setText(f"Run: {run}")

        # Point Information
        self.point_lat.setText(f"Lat: {result.get('point_lat', '--')}")
        self.point_lon.setText(f"Lon: {result.get('point_lon', '--')}")
        self.point_fl.setText(f"FL: {result.get('point_fl', '--')}")
        awci_val = result.get('point_awci', '--')
        level = result.get('point_level', 'High')
        self.point_awci.setText(f"AWCI: {awci_val}  {level}")

        # Components point
        self.comp_point.setText(
            f"Lat: {result.get('point_lat', '--')}  "
            f"Lon: {result.get('point_lon', '--')}  "
            f"FL: {result.get('point_fl', '--')}  "
            f"AWCI: {awci_val} ({level})"
        )

        # Vertical Profile
        profile = result.get('vertical_profile', {})
        for fl, lbl in self.profile_labels.items():
            if fl in profile:
                val = profile[fl]
                lbl.setText(f"{fl}: {val}  {'█' * int(val/10)}")
                lbl.setStyleSheet("color: #a0a0c0; font-size: 9px; font-family: monospace;")
            else:
                lbl.setText(f"{fl}: --")

    def set_data(self, awci_result: Dict[str, Any]):
        """Alias for update_with_awci_result."""
        self.update_with_awci_result(awci_result)
