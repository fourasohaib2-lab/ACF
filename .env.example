# Copy this file to .env (already gitignored - never commit real
# credentials) and fill in your own EUMETSAT Data Store API key.
#
# How to get one (free):
#   1. Create an account at https://data.eumetsat.int (or WEkEO)
#   2. Generate a Consumer Key/Secret at https://api.eumetsat.int/api-key/
#   3. Paste them below.
#
# Used by acf.connectors.eumetsat_mtg.EUMETSATMTGConnector to fetch live
# MTG (Météosat Troisième Génération / FCI instrument) full-disk imagery
# for the map basemap (see acf/gui/map/mtg_basemap.py). Without these
# set, the connector still works (the Data Store's search/browse
# endpoints currently allow anonymous access) but is more likely to be
# rate-limited - see EUMETSATMTGConnector.has_credentials.

EUMETSAT_CONSUMER_KEY=
EUMETSAT_CONSUMER_SECRET=

# Base URL of the real AWCI FastAPI backend (src/awci/api/app.py),
# read by the Next.js dashboard's API client (lib/api.ts). Defaults to
# http://127.0.0.1:8010 (the local dev server: `.venv/bin/python -m
# uvicorn awci.api.app:create_app --factory --host 127.0.0.1 --port 8010`)
# when unset.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8010
