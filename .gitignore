###############################################################################
# Atmospheric Complexity Framework (ACF)
# .gitignore
###############################################################################

# Python
__pycache__/
*.py[cod]
*$py.class

# C extensions
*.so

# Build
build/
dist/
*.egg-info/
.eggs/

# Virtual Environment
.venv/
venv/
env/

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit tests
.pytest_cache/
.coverage
htmlcov/

# Type checker
.mypy_cache/

# Ruff
.ruff_cache/

# PyCharm
.idea/

# VS Code
.vscode/

# Linux
*~
*.swp
*.swo

# macOS
.DS_Store

# Windows
Thumbs.db
Desktop.ini

# Logs
logs/
*.log

# Runtime
# NOTE (correction): "output/" (no leading slash) matched ANY directory
# named "output" anywhere in the tree, not just a repo-root runtime
# artifacts dir - this silently excluded the real source package
# src/acf/simulation_engine/output/ (NetcdfWriter, ZarrWriter) from git
# entirely, for the project's whole history (git log shows zero commits
# ever touching those files despite them being real, tested code - see
# tests/test_simulation_engine.py::test_output_writers). Anchored to
# the repo root so it only matches the intended runtime dir.
/output/
# Anchored for the same reason as /output/ above - defends against a
# future src/ (or tests/tools/etc.) module/package that happens to be
# named "tmp" or "temp" from being silently excluded the same way.
/tmp/
/temp/

# Jupyter
.ipynb_checkpoints/

# Environment variables
.env

# Qt
*.pro.user
*.qrc.depends

# Compiled Python
*.pyo

# Backup
*.bak
*.orig

# Project files
project/*.pdf
project/*.docx
.aider*
